---
import ThemeToggle from './ThemeToggle.astro';
import { repoUrl } from '../lib/meta.ts';

const NPM = 'https://www.npmjs.com/package/daypass';
const links = [
	{ href: '/docs/', label: 'Docs' },
	{ href: '/docs/quickstart/', label: 'Quickstart' },
	{ href: '/docs/threat-model/', label: 'Threat model' },
	{ href: '/changelog/', label: 'Changelog' },
	{ href: '/security/', label: 'Security' },
	{ href: NPM, label: 'npm' },
];
---

<header class="site-header">
	<div class="land-wrap bar">
		<a class="wordmark" href="/" aria-label="Daypass home">
			<img src="/favicon.svg" width="22" height="22" alt="" />
			<span>daypass</span>
		</a>
		<nav aria-label="Site">
			<ul>
				{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
			</ul>
		</nav>
		<div class="tools">
			<a class="icon-btn github" href={repoUrl} aria-label="Daypass on GitHub">
				<svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
					<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
				</svg>
				<span class="label">GitHub</span>
			</a>
			<ThemeToggle />
		</div>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--sl-color-hairline);
		background: var(--sl-color-bg);
	}
	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
		min-height: 3.5rem;
		padding-block: 0.6rem;
	}
	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-weight: 600;
		font-size: 1.05rem;
		color: var(--sl-color-white);
		margin-right: auto;
	}
	.wordmark img {
		border-radius: 5px;
	}
	.wordmark:hover {
		text-decoration: none;
	}
	nav {
		order: 3;
		flex-basis: 100%;
	}
	nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		font-size: 0.875rem;
	}
	nav a {
		color: var(--sl-color-gray-2);
	}
	nav a:hover {
		color: var(--sl-color-white);
	}
	.tools {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	.icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		height: 2.25rem;
		min-width: 2.25rem;
		padding: 0 0.6rem;
		border-radius: 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		color: var(--sl-color-white);
		font-size: 0.85rem;
		font-weight: 500;
	}
	.icon-btn:hover {
		background: var(--sl-color-bg-nav);
		text-decoration: none;
	}
	.icon-btn .label {
		display: none;
	}
	@media (min-width: 50em) {
		nav {
			order: 0;
			flex-basis: auto;
		}
		nav ul {
			gap: 1.25rem;
			font-size: 0.9rem;
		}
		.icon-btn .label {
			display: inline;
		}
	}
</style>
