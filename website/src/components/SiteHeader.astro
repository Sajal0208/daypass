---
import ThemeToggle from './ThemeToggle.astro';
import { repoUrl } from '../lib/meta.ts';

const NPM = 'https://www.npmjs.com/package/daypass';
const links = [
	{ href: '/docs/', label: 'Docs' },
	{ href: '/changelog/', label: 'Changelog' },
	{ href: '/security/', label: 'Security' },
	{ href: '/roadmap/', label: 'Roadmap' },
	{ href: repoUrl, label: 'GitHub' },
	{ href: NPM, label: 'npm' },
];
---

<header class="site-header">
	<div class="land-wrap bar">
		<a class="wordmark" href="/" aria-label="Daypass home">
			<img src="/favicon.svg" width="22" height="22" alt="" />
			<span>daypass</span><span class="blk" aria-hidden="true">_</span>
		</a>
		<nav aria-label="Site">
			<ul>
				{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
			</ul>
		</nav>
		<ThemeToggle />
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		border-bottom: 1px solid var(--land-line);
		background: color-mix(in srgb, var(--sl-color-bg) 85%, transparent);
		backdrop-filter: blur(8px);
	}
	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
		min-height: 3.5rem;
		padding-block: 0.6rem;
	}
	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 1.05rem;
		letter-spacing: -0.02em;
		color: var(--sl-color-white);
		margin-right: auto;
	}
	.wordmark img {
		border-radius: 0;
	}
	.blk {
		margin-left: -0.4rem;
		color: var(--sl-color-text-accent);
	}
	.wordmark:hover {
		text-decoration: none;
	}
	nav {
		order: 3;
		flex-basis: 100%;
	}
	nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		text-transform: lowercase;
	}
	nav a {
		color: var(--sl-color-gray-2);
	}
	nav a:hover {
		color: var(--sl-color-text-accent);
		text-decoration: none;
	}
	@media (min-width: 50em) {
		nav {
			order: 0;
			flex-basis: auto;
		}
		nav ul {
			gap: 1.25rem;
			font-size: 0.825rem;
		}
	}
</style>
