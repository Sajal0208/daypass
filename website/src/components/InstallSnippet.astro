---
interface Props {
	command: string;
}
const { command } = Astro.props;
---

<div class="install">
	<pre class="land-code"><code><span class="ps" aria-hidden="true">$ </span>{command}</code></pre>
	<button type="button" class="copy" data-copy={command} aria-label={`Copy "${command}"`}>Copy</button>
</div>

<style>
	.install {
		display: flex;
		align-items: stretch;
		max-width: 28rem;
	}
	.ps {
		color: var(--sl-color-text-accent);
		user-select: none;
	}
	.install pre {
		flex: 1;
		min-width: 0;
		display: flex;
		align-items: center;
	}
	.copy {
		flex: none;
		padding: 0 0.85rem;
		border-radius: 0;
		border: 1px solid var(--land-line);
		border-left: 0;
		background: var(--land-panel);
		color: var(--sl-color-white);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		text-transform: lowercase;
		cursor: pointer;
	}
	.copy:hover {
		color: var(--sl-color-text-accent);
	}
</style>

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
		button.addEventListener('click', async () => {
			const text = button.dataset.copy ?? '';
			let ok = false;
			try {
				await navigator.clipboard.writeText(text);
				ok = true;
			} catch {
				ok = false;
			}
			const idle = button.textContent;
			button.textContent = ok ? 'Copied' : 'Select and copy';
			setTimeout(() => (button.textContent = idle), 1600);
		});
	}
</script>
