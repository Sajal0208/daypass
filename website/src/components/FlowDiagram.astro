---
/**
 * The request path, drawn twice: a wide left-to-right version and a narrow top-to-bottom one.
 * CSS shows one of them depending on the viewport. Both say the same thing, in the same words.
 *
 * What is drawn matches the code: the MCP server reads the lease file written by `daypass open`
 * (src/mcp/state.ts), parses every statement with libpg-query (src/core/guard.ts), connects as
 * the restricted role with an RDS IAM token and a verified, pinned TLS CA (src/mcp/db.ts), and
 * appends one JSON line per call to ~/.daypass/audit.jsonl (src/core/audit.ts).
 */
const claim =
	'A human opens a lease in a terminal. Claude Code sends SQL to the Daypass MCP server, which checks that the lease is live and that the statement is a single SELECT, then runs it as a restricted Postgres role over pinned TLS with an IAM token. The role sees visible columns only, read-only, with a 10 second timeout. Every call appends one JSON line to audit.jsonl.';
---

<figure class="flow">
	{/* Wide layout: nodes left to right, lease above the server, audit below. */}
	<svg
		class="wide"
		viewBox="0 0 880 330"
		role="img"
		aria-labelledby="flow-wide-title flow-wide-desc"
		font-family="var(--font-sans)"
		font-size="12"
	>
		<title id="flow-wide-title">How a query travels through Daypass</title>
		<desc id="flow-wide-desc">{claim}</desc>
		<defs>
			<marker id="fw-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
				<path d="M0 0.5 9 5 0 9.5z" fill="currentColor" />
			</marker>
		</defs>

		{/* daypass open */}
		<rect x="330" y="14" width="220" height="58" rx="6" class="node" />
		<text x="440" y="38" text-anchor="middle" class="title mono">daypass open</text>
		<text x="440" y="58" text-anchor="middle" class="sub">you, in a terminal</text>

		{/* Claude Code */}
		<rect x="10" y="140" width="160" height="68" rx="6" class="node" />
		<text x="90" y="168" text-anchor="middle" class="title">Claude Code</text>
		<text x="90" y="190" text-anchor="middle" class="sub">or any MCP client</text>

		{/* Daypass MCP server (the gate; the one accent-coloured element) */}
		<rect x="310" y="136" width="260" height="76" rx="6" class="node gate" />
		<text x="440" y="162" text-anchor="middle" class="title">Daypass MCP server</text>
		<text x="440" y="185" text-anchor="middle" class="sub mono">SELECT-only parser (libpg-query)</text>

		{/* Postgres role */}
		<rect x="710" y="140" width="160" height="68" rx="6" class="node" />
		<text x="790" y="168" text-anchor="middle" class="title">Postgres role</text>
		<text x="790" y="190" text-anchor="middle" class="sub mono">daypass_ro</text>

		{/* audit.jsonl */}
		<rect x="330" y="272" width="220" height="48" rx="6" class="node" />
		<text x="440" y="301" text-anchor="middle" class="title mono">~/.daypass/audit.jsonl</text>

		{/* lease file -> server */}
		<line x1="440" y1="72" x2="440" y2="134" class="edge" marker-end="url(#fw-arrow)" />
		<text x="450" y="107" class="label">lease live?</text>

		{/* Claude -> server */}
		<line x1="170" y1="174" x2="308" y2="174" class="edge" marker-end="url(#fw-arrow)" />
		<text x="240" y="164" text-anchor="middle" class="label">query(sql) over MCP</text>

		{/* server -> role, and the rows back */}
		<line x1="570" y1="160" x2="708" y2="160" class="edge" marker-end="url(#fw-arrow)" />
		<text x="640" y="130" text-anchor="middle" class="label">IAM token · TLS pinned</text>
		<line x1="710" y1="190" x2="572" y2="190" class="edge" marker-end="url(#fw-arrow)" />
		<text x="640" y="226" text-anchor="middle" class="label">visible columns only,</text>
		<text x="640" y="242" text-anchor="middle" class="label">read-only, 10 s</text>

		{/* server -> audit */}
		<line x1="440" y1="212" x2="440" y2="270" class="edge" marker-end="url(#fw-arrow)" />
		<text x="450" y="245" class="label">one JSON line per call</text>
	</svg>

	{/* Narrow layout: lease and client on top, then the server, the role, the audit file. */}
	<svg
		class="narrow"
		viewBox="0 0 360 424"
		role="img"
		aria-labelledby="flow-narrow-title flow-narrow-desc"
		font-family="var(--font-sans)"
		font-size="11"
	>
		<title id="flow-narrow-title">How a query travels through Daypass</title>
		<desc id="flow-narrow-desc">{claim}</desc>
		<defs>
			<marker id="fn-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
				<path d="M0 0.5 9 5 0 9.5z" fill="currentColor" />
			</marker>
		</defs>

		<rect x="10" y="10" width="165" height="58" rx="6" class="node" />
		<text x="92" y="34" text-anchor="middle" class="title mono">daypass open</text>
		<text x="92" y="54" text-anchor="middle" class="sub">you, in a terminal</text>

		<rect x="185" y="10" width="165" height="58" rx="6" class="node" />
		<text x="267" y="34" text-anchor="middle" class="title">Claude Code</text>
		<text x="267" y="54" text-anchor="middle" class="sub">or any MCP client</text>

		<line x1="92" y1="68" x2="92" y2="130" class="edge" marker-end="url(#fn-arrow)" />
		<text x="100" y="104" class="label">lease live?</text>
		<line x1="267" y1="68" x2="267" y2="130" class="edge" marker-end="url(#fn-arrow)" />
		<text x="275" y="104" class="label">query(sql)</text>

		<rect x="60" y="132" width="290" height="72" rx="6" class="node gate" />
		<text x="205" y="158" text-anchor="middle" class="title">Daypass MCP server</text>
		<text x="205" y="182" text-anchor="middle" class="sub mono">SELECT-only parser (libpg-query)</text>

		<line x1="80" y1="204" x2="80" y2="268" class="edge" marker-end="url(#fn-arrow)" />
		<line x1="330" y1="272" x2="330" y2="208" class="edge" marker-end="url(#fn-arrow)" />
		<text x="205" y="228" text-anchor="middle" class="label">↓ IAM token · TLS pinned</text>
		<text x="205" y="246" text-anchor="middle" class="label">↑ visible columns only,</text>
		<text x="205" y="262" text-anchor="middle" class="label">read-only, 10 s</text>

		<rect x="60" y="272" width="290" height="58" rx="6" class="node" />
		<text x="205" y="296" text-anchor="middle" class="title">Postgres role</text>
		<text x="205" y="316" text-anchor="middle" class="sub mono">daypass_ro</text>

		{/* server -> audit, routed down the left gutter past the role */}
		<path d="M60 168 H30 V388 H56" fill="none" class="edge" marker-end="url(#fn-arrow)" />
		<text x="60" y="354" class="label">one JSON line per call</text>
		<rect x="60" y="364" width="290" height="48" rx="6" class="node" />
		<text x="205" y="393" text-anchor="middle" class="title mono">~/.daypass/audit.jsonl</text>
	</svg>

	<figcaption>
		The server checks the lease and parses the statement before anything reaches the database;
		the role itself cannot write or see hidden columns, and every call is logged.
	</figcaption>
</figure>

<style>
	.flow {
		margin: 0;
		color: var(--sl-color-white);
	}
	svg {
		display: block;
		width: 100%;
		height: auto;
		max-width: 56rem;
	}
	.narrow {
		max-width: 24rem;
	}
	.wide {
		display: none;
	}
	@media (min-width: 48em) {
		.wide {
			display: block;
		}
		.narrow {
			display: none;
		}
	}
	.node {
		fill: var(--sl-color-bg-nav);
		stroke: currentColor;
		stroke-opacity: 0.35;
		stroke-width: 1;
	}
	.gate {
		stroke: var(--sl-color-accent);
		stroke-opacity: 1;
		stroke-width: 2;
	}
	.edge {
		stroke: currentColor;
		stroke-width: 1.25;
	}
	.title {
		fill: currentColor;
		font-size: 14px;
		font-weight: 600;
	}
	.sub {
		fill: currentColor;
		fill-opacity: 0.72;
	}
	.label {
		fill: currentColor;
		fill-opacity: 0.85;
	}
	.mono {
		font-family: var(--font-mono);
	}
	.title.mono {
		font-size: 13px;
	}
	figcaption {
		margin-top: 1rem;
		max-width: 44rem;
		font-size: 0.9rem;
		color: var(--land-muted);
	}
</style>
