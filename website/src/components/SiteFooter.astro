---
import { repoUrl } from '../lib/meta.ts';

const NPM = 'https://www.npmjs.com/package/daypass';
const columns = [
	{
		title: 'Project',
		links: [
			{ href: repoUrl, label: 'GitHub' },
			{ href: NPM, label: 'npm' },
			{ href: '/changelog/', label: 'Changelog' },
			{ href: '/roadmap/', label: 'Roadmap' },
		],
	},
	{
		title: 'Docs',
		links: [
			{ href: '/docs/quickstart/', label: 'Quickstart' },
			{ href: '/docs/concepts/', label: 'Concepts' },
			{ href: '/docs/threat-model/', label: 'Threat model' },
			{ href: '/docs/faq/', label: 'FAQ' },
			{ href: '/docs/plugin/', label: 'Claude Code plugin' },
		],
	},
	{
		title: 'Policies',
		links: [
			{ href: `${repoUrl}/blob/main/LICENSE`, label: 'MIT license' },
			{ href: '/security/', label: 'Security policy' },
			{ href: '/support/', label: 'Support' },
			{ href: `${repoUrl}/blob/main/CONTRIBUTING.md`, label: 'Contributing' },
		],
	},
];
---

<footer class="site-footer">
	<div class="land-wrap">
		<div class="cols">
			<div class="brand">
				<a class="wordmark" href="/" aria-label="Daypass home">
					<img src="/favicon.svg" width="20" height="20" alt="" />
					<span>daypass</span>
				</a>
				<p>Temporary, read-only, audited Postgres access for AI coding agents.</p>
			</div>
			{
				columns.map((c) => (
					<nav aria-label={c.title}>
						<h2>{c.title}</h2>
						<ul>
							{c.links.map((l) => (
								<li>
									<a href={l.href}>{l.label}</a>
								</li>
							))}
						</ul>
					</nav>
				))
			}
		</div>
		<p class="built">
			MIT. Built by <a href="https://vocobase.com">Vocobase</a>.
		</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--sl-color-hairline);
		padding-block: 2.5rem 2rem;
		font-size: 0.875rem;
		color: var(--land-muted);
	}
	.cols {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.75rem 1.5rem;
	}
	.brand {
		grid-column: 1 / -1;
		max-width: 22rem;
	}
	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-weight: 600;
		font-size: 1rem;
		color: var(--sl-color-white);
		margin-bottom: 0.5rem;
	}
	.wordmark img {
		border-radius: 5px;
	}
	.wordmark:hover {
		text-decoration: none;
	}
	h2 {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-weight: 600;
		color: var(--land-muted);
		margin-bottom: 0.6rem;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.35rem;
	}
	.cols a {
		color: var(--sl-color-gray-2);
	}
	.cols a:hover {
		color: var(--sl-color-white);
	}
	.built {
		margin-top: 2rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--sl-color-hairline);
	}
	.built a {
		color: var(--sl-color-gray-2);
	}
	@media (min-width: 50em) {
		.cols {
			grid-template-columns: 1.5fr repeat(3, 1fr);
		}
		.brand {
			grid-column: auto;
		}
	}
</style>
